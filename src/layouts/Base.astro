---
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="stylesheet" href={`${base}styles/global.css`} />
</head>
<body>
  <header>
    <nav>
      <a href={base} class="logo">ToolBreakdown</a>
      <div class="nav-links">
        <a href={`${base}best/`}>Best Picks</a>
        <a href={`${base}vs/`}>VS</a>
        <a href={`${base}alternatives/`}>Alternatives</a>
        <a href={`${base}blog/`}>Blog</a>
      </div>
    </nav>
  </header>
  <main>
    <slot />
  </main>
  <footer>
    <p>&copy; {new Date().getFullYear()} ToolBreakdown &mdash; Honest SaaS tool comparisons, updated daily.</p>
    <p><a href={`${base}disclosure/`}>Affiliate Disclosure</a></p>
  </footer>
</body>
</html>
