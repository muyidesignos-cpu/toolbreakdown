---
import Base from '../../layouts/Base.astro';
---

<Base>
  <h1>Best Picks</h1>
  <p>Curated lists of the best SaaS tools for every use case and budget.</p>

  <div class="category-grid" style="margin-top: 2rem;">
    <a href={`${import.meta.env.BASE_URL}best/ai-writing/`} class="category-card"><h3>AI Writing Tools</h3><p>Jasper, Copy.ai, Writesonic &amp; more</p></a>
    <a href={`${import.meta.env.BASE_URL}best/project-management/`} class="category-card"><h3>Project Management</h3><p>Asana, Monday, ClickUp</p></a>
    <a href={`${import.meta.env.BASE_URL}best/email-marketing/`} class="category-card"><h3>Email Marketing</h3><p>Mailchimp, ConvertKit, Beehiiv</p></a>
    <a href={`${import.meta.env.BASE_URL}best/vpn/`} class="category-card"><h3>VPN Services</h3><p>NordVPN, ExpressVPN, Surfshark</p></a>
    <a href={`${import.meta.env.BASE_URL}best/website-builders/`} class="category-card"><h3>Website Builders</h3><p>Wix, Squarespace, Webflow</p></a>
    <a href={`${import.meta.env.BASE_URL}best/hosting/`} class="category-card"><h3>Web Hosting</h3><p>SiteGround, Bluehost, Cloudways</p></a>
  </div>
</Base>
