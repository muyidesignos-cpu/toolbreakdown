---
const base = import.meta.env.BASE_URL;

const categories = [
  { slug: 'ai-writing', name: 'AI Writing Tools', desc: 'Jasper, Copy.ai, Writesonic & more' },
  { slug: 'project-management', name: 'Project Management', desc: 'Asana, Monday, ClickUp compared' },
  { slug: 'email-marketing', name: 'Email Marketing', desc: 'Mailchimp, ConvertKit, Beehiiv' },
  { slug: 'vpn', name: 'VPN Services', desc: 'NordVPN, ExpressVPN, Surfshark' },
  { slug: 'website-builders', name: 'Website Builders', desc: 'Wix, Squarespace, Webflow' },
  { slug: 'hosting', name: 'Web Hosting', desc: 'SiteGround, Bluehost, Cloudways' },
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ToolBreakdown — Honest SaaS Tool Comparisons</title>
  <meta name="description" content="In-depth breakdowns of SaaS tools. No fluff. Just the data you need." />
  <link rel="stylesheet" href={`${base}styles/global.css`} />
</head>
<body>
  <header>
    <nav>
      <a href={base} class="logo">ToolBreakdown</a>
      <div class="nav-links">
        <a href={`${base}best/`}>Best Picks</a>
        <a href={`${base}vs/`}>VS</a>
        <a href={`${base}alternatives/`}>Alternatives</a>
        <a href={`${base}blog/`}>Blog</a>
      </div>
    </nav>
  </header>
  <main>
    <section class="hero">
      <h1>Stop guessing. Start comparing.</h1>
      <p>In-depth breakdowns of SaaS tools. No fluff. Just the data you need.</p>
    </section>

    <section class="categories">
      <h2>Explore by Category</h2>
      <div class="category-grid">
        {categories.map(cat => (
          <a href={`${base}vs/`} class="category-card">
            <h3>{cat.name}</h3>
            <p>{cat.desc} — see our latest comparisons</p>
          </a>
        ))}
      </div>
    </section>

    <section class="latest">
      <h2>Latest Comparisons</h2>
      <p>Check out our <a href={`${base}vs/`}>VS Comparisons</a> — new articles daily.</p>
    </section>
  </main>
  <footer>
    <p>&copy; 2026 ToolBreakdown &mdash; <a href={`${base}disclosure/`}>Affiliate Disclosure</a></p>
  </footer>
</body>
</html>
